+/** Donut + value list. rows: [{label, value}] (zero/negative rows are dropped). */
+const OpDonut = ({ title, sub, rows, centerValue, centerLabel, valueFormat = (v) => v, size = 150 }) => {
+  const data = (rows || []).filter((r) => Number(r.value) > 0);
+  const total = data.reduce((a, r) => a + Number(r.value), 0);
