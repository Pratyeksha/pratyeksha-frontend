{
  "name": "Pratyeksha Owner Suite",
  "short_name": "Owner",
  "description": "Live revenue, P&L, inventory, staff and kitchen intelligence for your restaurant — in one app.",
  "start_url": "/owner/",
  "scope": "/owner/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
